{
  "name": "glyphpack",
  "version": "0.1.0",
  "description": "Dense UTF-16 payloads with a Rust/Wasm decoder and gzip/base64 ESM loader",
  "license": "0BSD",
  "type": "commonjs",
  "exports": {
    ".": "./dist/default.min.mjs",
    "./full": "./dist/full.min.mjs",
    "./core": "./dist/core.min.mjs",
    "./none": "./dist/none.min.mjs",
    "./fast-none": "./dist/fast-none.min.mjs",
    "./high-memory": "./dist/high-memory.min.mjs"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "cargo run --release --locked -- build --all",
    "test": "cargo test --locked && cargo run --release --locked -- test-js",
    "test:browser": "cargo run --release --locked -- bench smoke",
    "bench": "cargo run --release --locked -- bench run",
    "bench:encode": "cargo run --release --locked --example encode_bench",
    "summary": "cargo run --release --locked -- summary",
    "build:site": "cargo run --release --locked -- site --output generated/pages",
    "test:site": "node tests/site.cjs",
    "test:types": "tsc --noEmit --strict --module nodenext --target es2022 tests/types.mts",
    "test:package": "node tests/package.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "binaryen": "129.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "author": "NeoX",
  "types": "./dist/default.min.d.mts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Neo-X-Minecraft/glyphpack.git"
  },
  "homepage": "https://neo-x-minecraft.github.io/glyphpack/",
  "bugs": {
    "url": "https://github.com/Neo-X-Minecraft/glyphpack/issues"
  }
}
